# All user-facing build options live here. Contradictory combinations fail at configure time
# (same principle as Config::validate() at runtime — see docs/design/05-api-config.md).
option(MVSLAM_WITH_CERES  "Build the Ceres solver adapter (primary backend)" ON)
option(MVSLAM_WITH_G2O    "Build the g2o solver adapter (optional)" OFF)
option(MVSLAM_WITH_GTSAM  "Build the GTSAM solver adapter (optional, 4.3 alpha)" OFF)
option(MVSLAM_BUILD_TESTS "Build unit/integration tests (GoogleTest)" ON)
option(MVSLAM_BUILD_APPS  "Build dataset runner and tools" ON)
option(MVSLAM_BUILD_BENCH "Build micro-benchmarks (google/benchmark)" OFF)
option(MVSLAM_SHARED      "Build libmvslam as a shared library (single library packaging)" OFF)
option(MVSLAM_WERROR      "Treat warnings as errors for mvslam targets" OFF)
option(MVSLAM_LTO         "Enable interprocedural optimization for Release" OFF)
option(MVSLAM_CERES_SCHUR_SPECIALIZATIONS "Ceres Schur template specializations (faster BA, slower build)" ON)
set(MVSLAM_SANITIZER "none" CACHE STRING "none|asan|tsan|ubsan")
set_property(CACHE MVSLAM_SANITIZER PROPERTY STRINGS none asan tsan ubsan)
set(MVSLAM_OPENCV_SOURCE "auto" CACHE STRING "auto|system|submodule|none")
set_property(CACHE MVSLAM_OPENCV_SOURCE PROPERTY STRINGS auto system submodule none)

if(IOS)
  # Cross-compiled targets cannot run tests/apps on the host.
  set(MVSLAM_BUILD_TESTS OFF CACHE BOOL "" FORCE)
  set(MVSLAM_BUILD_APPS OFF CACHE BOOL "" FORCE)
  set(MVSLAM_SHARED OFF CACHE BOOL "" FORCE)
endif()
if(NOT MVSLAM_WITH_CERES AND NOT MVSLAM_WITH_G2O AND NOT MVSLAM_WITH_GTSAM)
  message(FATAL_ERROR "At least one solver adapter must be enabled (MVSLAM_WITH_CERES/G2O/GTSAM)")
endif()
if(MVSLAM_SANITIZER STREQUAL "tsan" AND MVSLAM_SANITIZER_ASAN)
  message(FATAL_ERROR "tsan and asan are mutually exclusive")
endif()
if(MVSLAM_LTO)
  include(CheckIPOSupported)
  check_ipo_supported(RESULT _ipo_ok OUTPUT _ipo_msg)
  if(_ipo_ok)
    set(CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE ON)
  else()
    message(WARNING "IPO not supported: ${_ipo_msg}")
  endif()
endif()
