# OpenCV selection. MVSLAM_HAVE_OPENCV gates every translation unit that includes <opencv2/...>
# (frontend tracking/detection, dataset runner). Backend/map/core never depend on OpenCV.
set(MVSLAM_HAVE_OPENCV OFF)
set(_want_system OFF)
set(_want_submodule OFF)
if(MVSLAM_OPENCV_SOURCE STREQUAL "system")
  set(_want_system ON)
elseif(MVSLAM_OPENCV_SOURCE STREQUAL "submodule")
  set(_want_submodule ON)
elseif(MVSLAM_OPENCV_SOURCE STREQUAL "auto")
  set(_want_system ON)
  set(_want_submodule ON)
elseif(NOT MVSLAM_OPENCV_SOURCE STREQUAL "none")
  message(FATAL_ERROR "MVSLAM_OPENCV_SOURCE must be auto|system|submodule|none")
endif()

set(MVSLAM_OPENCV_MODULES core imgproc features2d calib3d video)
if(NOT IOS)
  list(APPEND MVSLAM_OPENCV_MODULES imgcodecs)
endif()

if(_want_system)
  find_package(OpenCV 4 QUIET COMPONENTS ${MVSLAM_OPENCV_MODULES})
  if(OpenCV_FOUND)
    set(MVSLAM_HAVE_OPENCV ON)
    set(MVSLAM_OPENCV_KIND "system ${OpenCV_VERSION}")
    add_library(mvslam_opencv INTERFACE)
    target_link_libraries(mvslam_opencv INTERFACE ${OpenCV_LIBS})
    target_include_directories(mvslam_opencv SYSTEM INTERFACE ${OpenCV_INCLUDE_DIRS})
  elseif(NOT _want_submodule)
    message(FATAL_ERROR "MVSLAM_OPENCV_SOURCE=system but OpenCV 4 was not found")
  endif()
endif()

if(NOT MVSLAM_HAVE_OPENCV AND _want_submodule)
  # In-tree trimmed build of the pinned submodule (same recipe as VINS_Remastered).
  string(REPLACE ";" "," _list "${MVSLAM_OPENCV_MODULES}")
  set(BUILD_LIST "${_list}" CACHE STRING "" FORCE)
  set(BUILD_TESTS OFF CACHE BOOL "" FORCE)
  set(BUILD_PERF_TESTS OFF CACHE BOOL "" FORCE)
  set(BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
  set(BUILD_opencv_apps OFF CACHE BOOL "" FORCE)
  set(BUILD_opencv_python3 OFF CACHE BOOL "" FORCE)
  set(BUILD_JAVA OFF CACHE BOOL "" FORCE)
  set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
  set(WITH_EIGEN OFF CACHE BOOL "" FORCE)      # keep OpenCV decoupled from our Eigen
  set(WITH_FFMPEG OFF CACHE BOOL "" FORCE)
  set(WITH_GTK OFF CACHE BOOL "" FORCE)
  set(WITH_QT OFF CACHE BOOL "" FORCE)
  set(WITH_OPENCL OFF CACHE BOOL "" FORCE)
  set(WITH_IPP OFF CACHE BOOL "" FORCE)
  set(WITH_ITT OFF CACHE BOOL "" FORCE)
  set(WITH_PROTOBUF OFF CACHE BOOL "" FORCE)
  set(WITH_OBSENSOR OFF CACHE BOOL "" FORCE)
  set(WITH_ADE OFF CACHE BOOL "" FORCE)
  set(OPENCV_GENERATE_PKGCONFIG OFF CACHE BOOL "" FORCE)
  set(CV_TRACE OFF CACHE BOOL "" FORCE)
  set(ENABLE_PRECOMPILED_HEADERS OFF CACHE BOOL "" FORCE)
  add_subdirectory("${MVSLAM_THIRD_PARTY}/opencv" EXCLUDE_FROM_ALL)
  set(MVSLAM_HAVE_OPENCV ON)
  set(MVSLAM_OPENCV_KIND "submodule 4.14.0")
  add_library(mvslam_opencv INTERFACE)
  foreach(_m ${MVSLAM_OPENCV_MODULES})
    target_link_libraries(mvslam_opencv INTERFACE opencv_${_m})
    # In-tree OpenCV does not populate INTERFACE_INCLUDE_DIRECTORIES; add module headers explicitly.
    target_include_directories(mvslam_opencv SYSTEM INTERFACE "${MVSLAM_THIRD_PARTY}/opencv/modules/${_m}/include")
  endforeach()
  target_include_directories(mvslam_opencv SYSTEM INTERFACE "${CMAKE_BINARY_DIR}")  # cvconfig.h, opencv_modules.hpp
endif()

if(MVSLAM_HAVE_OPENCV)
  add_library(mvslam::opencv ALIAS mvslam_opencv)
  message(STATUS "OpenCV: ${MVSLAM_OPENCV_KIND}")
else()
  message(STATUS "OpenCV: disabled (frontend image code and dataset runner are not built)")
endif()
